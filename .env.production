# Production matchmaking backend. This is a public value, not a secret:
# the URL ships inside the client bundle and is already committed in
# public/_headers (connect-src) and .env.example. Keeping it here makes
# every production build self-contained — Cloudflare Pages, CI, or a local
# `pnpm build` — with no dashboard state to drift (the F774 outage was a
# build that silently lacked this var). If the Worker URL ever moves, it
# must change here and in public/_headers in the same commit.
# Local override (untracked, .env.local via *.local in .gitignore):
# VITE_MATCHMAKING_URL=http://127.0.0.1:8787
VITE_MATCHMAKING_URL=https://fuurma-matchmaking.sergiformatjer1999.workers.dev
